# Seeed Studio XIAO ESP32-S3 defaults
CONFIG_BOARD_SEEED_XIAO_ESP32S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y

# User LED on the standard XIAO ESP32-S3 module
CONFIG_LED_STATUS_GPIO=21
CONFIG_LED_RGB_GPIO=-1

# XIAO ESP32-S3 header defaults for an external I2S DAC
# D8=GPIO7, D9=GPIO8, D10=GPIO9
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=7
CONFIG_I2S_WS_IO=9
CONFIG_I2S_DO_IO=8
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1

# Optional peripherals are disabled by default on the bare XIAO module.
CONFIG_BAT_CHANNEL=-1
CONFIG_DAC_I2C_SDA=-1
CONFIG_DAC_I2C_SCL=-1
CONFIG_JACK_GPIO=-1
CONFIG_SPKFAULT_GPIO=-1
CONFIG_MUTE_GPIO=-1
